{
  "name": "creative-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx apps/server/index.ts",
    "serve": "tsx apps/server/index.ts",
    "worker": "tsx apps/worker/index.ts",
    "creative": "tsx apps/cli/index.ts",
    "mcp": "tsx apps/mcp/index.ts",
    "build": "vite build --config apps/studio/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:contract:tradecase",
    "test:contract:tradecase": "tsx scripts/verify-tradecase-contract.ts",
    "check": "pnpm typecheck && pnpm test:contract:tradecase && pnpm build",
    "format": "prettier --write apps packages scripts rules"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.6",
    "@fastify/static": "10.1.8",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "archiver": "8.0.0",
    "commander": "15.0.0",
    "fastify": "5.12.7",
    "openai": "7.45.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/archiver": "8.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.26.0"
}
