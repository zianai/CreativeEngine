  "skill_snapshot": {
    "id": "product-concept",
    "version": "1.1.0",
    "digest": "1f2ff6a6bdcd014001b49d53073ceda85e45343cd7909bc22503b7dea3535438",
    "prompt_template": "Explore a product design direction for an internal design review. Make the stated direction visually distinct from alternatives. Address the provided user pain points and retain explicit dimensional, cost and manufacturing constraints as design goals. Do not claim technical feasibility, safety approval or manufacturing readiness. Distinguish proposed functionality from confirmed product facts.\n",
    "qa_profile": [
      "distinct_direction",
      "requirements_covered",
      "constraints_preserved",
      "concept_identity",
      "concept_label",
      "feasibility_uncertainty_visible",
      "human_review_required"
    ],
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Product Concept input",
      "type": "object",
      "required": [
        "project_id",
        "workflow",
        "requirements",
        "product"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "const": "product-concept"
        },
        "requirements": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "product": {
          "type": "object",
          "required": [
            "product_id",
            "stage"
          ],
          "properties": {
            "product_id": {
              "type": "string"
            },
            "stage": {
              "enum": [
                "existing_sku",
                "prototype",
                "concept"
              ]
            },
            "truth_snapshot_id": {
              "type": "string"
            }
          }
        },
        "allowed_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reference_asset_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skill_input": {
          "type": "object",
          "properties": {
            "design_direction": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000,
              "pattern": "\\S"
            }
          }
        },
        "variants": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "$comment": "The full wire schema is exported by packages/contracts; deterministic policy validation is mandatory after schema validation."
    },
    "defaults": {
      "fidelity": "exploratory",
      "strategy": "generate"
    }
  },
  "plan_directions": [
    "Three articulated trays joined at BOTH adjacent connections by wide flexible accordion/bellows sheets, each with at least FIVE continuous repeated pleats; the right tray tilts upward to expose unfolding pleats. No continuous monolithic silhouette or pin-jointed hardware."
  ],
  "api_credentials_inherited": false,
  "api_cost_usd": 0,
  "subscription_cost": "unmetered",
  "human_approval": false
