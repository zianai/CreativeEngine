# Local-only storage and server
CREATIVE_DATA_DIR=.creative-engine
PORT=4310
CREATIVE_WORKER=1
CREATIVE_CONCURRENCY=2
# See docs/provider-development.md for opt-in paid provider configuration.
# Never commit keys; paid batch authorization is separate from configuration.
# Optional structured semantic review (explicit paid opt-in per batch)
# CREATIVE_VISION_MODEL=<account-accessible vision model>
# CREATIVE_VISION_RESERVATION_USD=<conservative per-review reservation>
# CREATIVE_VISION_INPUT_USD_PER_MILLION=<documented rate>
# CREATIVE_VISION_OUTPUT_USD_PER_MILLION=<documented rate>
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare-2026-09-08
# OPENAI_IMAGE_EDIT_MODEL=gpt-image-2.5-sunburst-2026-09-08
# OPENAI_IMAGE_RESERVATION_USD=1
# ORACLE_ENABLED=false
